# API — production image. Build from monorepo root:
#   docker build -f deploy/Dockerfile.api -t car-rental-api .
# Run SQL migrations in CI / release (not on every container start), e.g.:
#   docker run --rm -e DATABASE_URL=... car-rental-migrate  # (see PRODUCTION.md)

FROM node:20-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json tsconfig.json ./
COPY scripts/prisma-generate-retry.cjs scripts/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/shared/package.json packages/shared/
RUN npm ci
COPY packages/shared packages/shared
COPY apps/api apps/api
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"
ENV TRUST_PROXY="true"
RUN npm run build -w @car-rental/shared
RUN npm run prisma:generate -w @car-rental/api
RUN npm run build:compile -w @car-rental/api
RUN npm prune --omit=dev

FROM node:20-bookworm-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs appuser
COPY --from=build /app /app
USER appuser
EXPOSE 3000
ENV NODE_ENV=production
ENV PORT=3000
CMD ["node", "apps/api/dist/main.js"]
