# Copy to deploy/.env (next to docker-compose.prod.yml) and set secrets.
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build
#
# Migrations: prisma migrate deploy against this stack's DATABASE_URL before first deploy.
#
# PostgreSQL backups are operator-owned — see docs/PRODUCTION.md (PostgreSQL backups and restore).

POSTGRES_PASSWORD=set-a-long-random-password
JWT_SECRET=set-a-different-32-char-min-secret
# Behind reverse proxy / load balancer — Express uses X-Forwarded-For for client IP + throttling (recommended in prod)
TRUST_PROXY=true

# A6: shared HTTP rate limits for multiple API replicas (host must match `redis` service name in compose)
REDIS_URL=redis://redis:6379

# A2: failed password / MFA step lockout (per user; use 0 to disable — not recommended for production)
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_LOCKOUT_MINUTES=15

# A3: require MFA for ADMIN / BRANCH_MANAGER (after onboarding). Leave unset/false until staff have enrolled MFA.
# AUTH_MFA_REQUIRED=true

# H1: OpenAPI — omit or 0 in production (default off). Never expose /docs publicly if you enable it.
# SWAGGER_ENABLE=0

# Browser origins allowed to call the API (comma-separated, no spaces)
CORS_ORIGINS=https://desk.example.com,https://www.example.com

# Inlined into the **web image** at build time — must be the URL **browsers** use (https, /v1).
NEXT_PUBLIC_API_URL=https://api.example.com/v1
NEXT_PUBLIC_DEFAULT_COMPANY_ID=
# Optional: desk VAT display on /quote (0–1; e.g. 0.22). Omit to use app default.
# NEXT_PUBLIC_VAT_RATE=0.22

# --- Stripe (live) — use sk_live_… + live webhook signing secret in real production ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Desk Checkout return URLs (must use https + your real host; Stripe replaces {CHECKOUT_SESSION_ID})
# STRIPE_CHECKOUT_SUCCESS_URL=https://desk.example.com/desk/reservations?stripe=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://desk.example.com/desk/reservations?stripe=cancelled
# Public /quote Checkout returns (optional; defaults use APP_PUBLIC_BASE_URL in app logic)
# STRIPE_PUBLIC_CHECKOUT_SUCCESS_URL=https://www.example.com/quote?stripe=rental_success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_PUBLIC_CHECKOUT_CANCEL_URL=https://www.example.com/quote?stripe=rental_cancel

# --- Email (C2/H2) — optional until SMTP_HOST + SMTP_FROM are set ---
# APP_PUBLIC_BASE_URL=https://www.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Bookings <bookings@example.com>
# PASSWORD_RESET_TTL_MINUTES=60
# Set to 0 / false / no to skip emailing Stripe Checkout links created by staff (default: send when SMTP on)
# EMAIL_STRIPE_CHECKOUT_LINKS=true
# Set to 0 / false / no to skip rental-paid / deposit-hold emails from Stripe webhooks
# EMAIL_STRIPE_WEBHOOK_EMAILS=true

# --- Handover (D3) + CaRGOS auto-enqueue — API container; align with counsel/ops (docs/PRODUCTION.md) ---
# HANDOVER_REQUIRE_SIGNED_AGREEMENT=true
# HANDOVER_REQUIRE_CARGOS=true
# HANDOVER_REQUIRE_ID_DOCUMENTS=false
# HANDOVER_REQUIRE_VERIFIED_ID_DOCUMENTS=false
# CARGOS_AUTO_ENQUEUE_ON_SIGN=true

# --- Worker (CaRGOS queue + B2 document retention) — same DATABASE_URL shape as API ---
# Max customer documents to purge per idle tick (0 = disable retention purge)
WORKER_RETENTION_PURGE_BATCH=25

# Mirror API storage so worker can delete blobs when purging expired CustomerDocuments.
# For Docker Compose with bundled volume, keep local + path below unless you switch API to S3.
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=/app/data/uploads

# When STORAGE_MODE=s3 on the API, set the same here (volume mount is harmless but unused).
# IAM, CORS, and smoke steps: docs/PRODUCTION.md (Object storage: S3 and MinIO).
# STORAGE_MODE=s3
# S3_REGION=eu-west-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_USE_PATH_STYLE=true

# Optional worker tuning (see apps/worker/src/main.ts and docs/PRODUCTION.md § CaRGOS)
# CARGOS_MAX_ATTEMPTS=5
# CARGOS_HTTP_TIMEOUT_MS=30000
# WORKER_POLL_IDLE_MS=2000
# WORKER_PROCESSING_STALE_MS=900000
# WORKER_CARGOS_MOCK_DELAY_MS=400
# Idle heartbeat for log-based liveness (ms; 0 = off). Example: 300000 = every 5 min when queue idle.
# WORKER_HEARTBEAT_LOG_MS=300000
#
# Optional: worker → API internal crons (Bearer WORKER_INTERNAL_SECRET — same as API). Compose: set WORKER_API_BASE_URL to http://api:3000/v1 (service name).
# WORKER_API_BASE_URL=http://127.0.0.1:3000/v1
# WORKER_INTERNAL_SECRET=
# WORKER_RENT_REMINDER_INTERVAL_MS=900000
# WORKER_SERVICE_DUE_INTERVAL_MS=3600000
# G3 mock OCR queue — set when API has CUSTOMER_DOCUMENT_OCR_AUTO=mock (0 = worker does not call cron)
# WORKER_CUSTOMER_DOCUMENT_OCR_INTERVAL_MS=900000
# G2 partner webhook queue — POST …/internal/cron/partner-webhook-deliveries (0 = worker does not call)
# WORKER_PARTNER_WEBHOOK_INTERVAL_MS=60000
