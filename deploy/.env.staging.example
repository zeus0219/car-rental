# Copy to deploy/.env.staging and set values.
# Staging: isolated from production — use different password, JWT, and hostnames.
#
# docker compose -f deploy/docker-compose.staging.yml --env-file deploy/.env.staging up -d --build
#
# Backup / restore drills: docs/PRODUCTION.md § PostgreSQL backups (lighter RPO on staging is common).

POSTGRES_PASSWORD=set-a-long-random-staging-password
JWT_SECRET=set-a-different-32char-min-secret-for-staging-only
TRUST_PROXY=true
# A6: same as production — Redis for shared `@nestjs/throttler` state (`redis` service in compose)
REDIS_URL=redis://redis:6379

# A2 / A3 / H1 — same semantics as production (staging often keeps AUTH_MFA_REQUIRED off for faster UAT)
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_LOCKOUT_MINUTES=15
# AUTH_MFA_REQUIRED=true
# SWAGGER_ENABLE=

# Staging CORS: origins where the staging web app is served (https)
CORS_ORIGINS=https://desk-staging.example.com

# Public API URL for the *browser* (used at web **image build**)
NEXT_PUBLIC_API_URL=https://api-staging.example.com/v1
NEXT_PUBLIC_DEFAULT_COMPANY_ID=

# Stripe — **test** mode only (no sk_live_). Passed through to the API container.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://desk-staging.example.com/desk/reservations?stripe=ok&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://desk-staging.example.com/desk/reservations?stripe=cancelled
# STRIPE_PUBLIC_CHECKOUT_SUCCESS_URL=https://desk-staging.example.com/quote?stripe=rental_success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_PUBLIC_CHECKOUT_CANCEL_URL=https://desk-staging.example.com/quote?stripe=rental_cancel

# Email (optional) — same vars as production; use staging web base for APP_PUBLIC_BASE_URL
# APP_PUBLIC_BASE_URL=https://desk-staging.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# EMAIL_STRIPE_CHECKOUT_LINKS=true
# EMAIL_STRIPE_WEBHOOK_EMAILS=true

# Desk handover gate (D3) / CaRGOS auto-enqueue — same as production; see PRODUCTION.md § Desk handover
# HANDOVER_REQUIRE_ID_DOCUMENTS=true
# HANDOVER_REQUIRE_VERIFIED_ID_DOCUMENTS=false
# Optional Bearer token for staging CaRGOS middleware when company adapter=HTTP.
# CARGOS_HTTP_SECRET=set-a-long-random-staging-cargos-token

# SDI staging middleware (E4). Company → SDI must be adapter=HTTP with staging sdiHttpUrl.
# SDI_HTTP_SECRET=set-a-long-random-staging-sdi-token
# SDI_CALLBACK_URL=https://api-staging.example.com/v1/integrations/sdi/callback
# SDI_CALLBACK_SECRET=set-a-long-random-staging-sdi-callback-token

# Worker (CaRGOS + B2 retention) — same DB as API in compose
WORKER_RETENTION_PURGE_BATCH=25
# Optional: WORKER_HEARTBEAT_LOG_MS=300000 — see PRODUCTION.md § Observability
# Optional worker → API crons — WORKER_API_BASE_URL, WORKER_INTERNAL_SECRET, WORKER_RENT_REMINDER_INTERVAL_MS, WORKER_SERVICE_DUE_INTERVAL_MS, WORKER_CUSTOMER_DOCUMENT_OCR_INTERVAL_MS (G3; 0 = off), WORKER_PARTNER_WEBHOOK_INTERVAL_MS (G2; 0 = off)

# Local uploads volume (matches api + worker in docker-compose.staging.yml)
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=/app/data/uploads

# When STORAGE_MODE=s3, set the same on API + worker (staging bucket name — not prod). See docs/PRODUCTION.md (Object storage: S3 and MinIO).
# STORAGE_MODE=s3
# S3_REGION=eu-west-1
# S3_BUCKET=car-rental-uploads-staging
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_USE_PATH_STYLE=true

# CaRGOS worker (optional; compose passes defaults — see PRODUCTION.md § CaRGOS)
# CARGOS_MAX_ATTEMPTS=5
# CARGOS_HTTP_TIMEOUT_MS=30000
# WORKER_POLL_IDLE_MS=2000
# WORKER_PROCESSING_STALE_MS=900000
# WORKER_CARGOS_MOCK_DELAY_MS=400

# Optional VAT display on /quote at **image build** time
# NEXT_PUBLIC_VAT_RATE=0.22
