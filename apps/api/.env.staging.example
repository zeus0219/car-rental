# Example for a server or CI "staging" deploy (not local dev).
# Copy to .env or inject via your orchestrator. Use a database that is NOT production.

# --- Isolation ---
# Set to a dedicated staging database (different host or at least different DB name).
DATABASE_URL="postgresql://user:pass@staging-db.example:5432/carrental_staging?schema=public"

PORT=3000
NODE_ENV=production
TRUST_PROXY=true

# Optional: Redis for @nestjs/throttler across multiple API replicas (same limits as prod; omit for single instance).
# REDIS_URL="redis://staging-redis.example:6379"

# Staging-only (must differ from production)
JWT_SECRET="replace-with-32-plus-chars-staging-only-secret"
CORS_ORIGINS="https://desk-staging.example.com"

# Stripe TEST mode only (Dashboard in test mode). Never sk_live_ here.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_CHECKOUT_SUCCESS_URL="https://desk-staging.example.com/desk/reservations?stripe=ok&session_id={CHECKOUT_SESSION_ID}"
# STRIPE_CHECKOUT_CANCEL_URL="https://desk-staging.example.com/desk/reservations?stripe=cancelled"

# Optional: same storage as dev or a staging-prefixed S3 bucket
# STORAGE_MODE=local
# STORAGE_LOCAL_ROOT=data/uploads-staging
