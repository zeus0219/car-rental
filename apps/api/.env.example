# Copy to .env in this folder (or use monorepo root .env and export DATABASE_URL)

DATABASE_URL="postgresql://carrental:carrental@localhost:5432/carrental?schema=public"

# Optional: Redis — A6 rate limiting (`@nestjs/throttler`) when running multiple API replicas; same URL can be used for workers later.
# REDIS_URL="redis://localhost:6379"

# API
PORT=3000
# NODE_ENV=development   # use production in real deploy; see docs/PRODUCTION.md
# Behind nginx / ALB / Cloud Run: set so client IP + throttler see X-Forwarded-For
# TRUST_PROXY=true

# CORS: comma-separated browser origins (Next desk + public site). Default: localhost:3001 only.
# **Required** when NODE_ENV=production (API will not start without it).
# CORS_ORIGINS="https://desk.yourco.example,https://app.yourco.example"

# H1: OpenAPI Swagger at http://localhost:3000/docs — **disabled in production** unless set to 1
# SWAGGER_ENABLE=1

# JWT (required in production: ≥32 chars, not a placeholder — see docs/PRODUCTION.md § API environment validation)
JWT_SECRET="change-me-in-local-dev"
JWT_EXPIRES_IN="7d"

# Optional: allow POST /v1/auth/register (default: false)
# AUTH_ALLOW_REGISTER="true"
#
# A2: optional account lockout after failed password **or MFA step** attempts (per user). Omit or 0 = disabled. Docker samples use 8 / 15.
# AUTH_LOGIN_MAX_ATTEMPTS=8
# AUTH_LOGIN_LOCKOUT_MINUTES=15
# When true, login only succeeds if the typed password meets strongPasswordSchema (users with old weak hashes use Forgot password).
# AUTH_LOGIN_REQUIRE_STRONG_PASSWORD=true
#
# A3: when true, ADMIN / BRANCH_MANAGER cannot sign in without MFA (or an in-progress TOTP setup). Leave false until privileged users enroll MFA, then set true in production. See docs/PRODUCTION.md.
# AUTH_MFA_REQUIRED=true

# File storage: local disk (default) or S3-compatible (MinIO, AWS, etc.)
# STORAGE_MODE="local"
# STORAGE_LOCAL_ROOT="data/uploads"
#
# When STORAGE_MODE=s3, agreement attachments use presigned PUT; configure bucket CORS for your web origin.
# S3_REGION="us-east-1"
# S3_BUCKET="car-rental-agreements"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="http://127.0.0.1:9000"   # MinIO; omit for AWS
# S3_USE_PATH_STYLE="true"              # required for most MinIO setups

# Stripe (optional — card payments + webhook to set reservation paidAt)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."   # from `stripe listen` or Dashboard webhook
# STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3001/desk/reservations?stripe=ok&session_id={CHECKOUT_SESSION_ID}"
# STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3001/desk/reservations?stripe=cancelled"
# C1: public /quote return URLs after Stripe (defaults use APP_PUBLIC_BASE_URL or http://localhost:3001)
# STRIPE_PUBLIC_CHECKOUT_SUCCESS_URL="http://localhost:3001/quote?stripe=rental_success&session_id={CHECKOUT_SESSION_ID}"
# STRIPE_PUBLIC_CHECKOUT_CANCEL_URL="http://localhost:3001/quote?stripe=rental_cancel"

# Handover gate (D3) before status → IN_PROGRESS — default: require signed agreement + CaRGOS success; ID docs off
# HANDOVER_REQUIRE_SIGNED_AGREEMENT="true"
# HANDOVER_REQUIRE_CARGOS="true"
# HANDOVER_REQUIRE_ID_DOCUMENTS="false"
# When both ID docs and this are on, handover requires ≥1 **staff-verified** ID-style document (B2)
# HANDOVER_REQUIRE_VERIFIED_ID_DOCUMENTS="false"

# CaRGOS worker (apps/worker — same DATABASE_URL; D4 HTTP retries / timeout)
# CARGOS_MAX_ATTEMPTS=5
# CARGOS_HTTP_TIMEOUT_MS=30000
# API “Transmit now” uses MOCK with no delay unless set:
# CARGOS_SEND_NOW_MOCK_DELAY_MS=0
# After rental agreement is SIGNED, auto-call POST /integrations/cargos/enqueue logic (same rules as manual). Set to 0/false/no/off to disable (desk manual enqueue only).
# CARGOS_AUTO_ENQUEUE_ON_SIGN="true"

# Optional: transactional email (C2) — e.g. acknowledge public "saved quote" (POST /public/quote-reservations)
# If SMTP_HOST is unset, no email is sent. When set, set SMTP_FROM; usually also SMTP_USER / SMTP_PASS.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE="false"    # "true" for port 465
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Bookings <bookings@example.com>"
# APP_PUBLIC_BASE_URL="https://www.example.com"   # no trailing slash; /quote, /booking/view, /auth/reset-password, desk staff invite link (C2/C3/H2)
# PASSWORD_RESET_TTL_MINUTES=60   # H2: forgot-password link lifetime (5–1440; default 60)
# Optional: set to 0 / false / no to skip emailing Stripe pay links to the customer (default: send when SMTP on)
# EMAIL_STRIPE_CHECKOUT_LINKS="true"
# Optional: set to 0 / false / no to skip "payment received" / "deposit hold" emails from Stripe webhooks
# EMAIL_STRIPE_WEBHOOK_EMAILS="true"
#
# C2: optional SMS (Twilio) — short ack after public *multi-line* quote batch (requires E.164-capable mobile on the form)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15551234567"   # your Twilio sender (E.164)
# SMS_PUBLIC_BATCH_ACK="true"         # off unless set truthy
#
# C2: one-time unpaid-rent reminder email (worker calls API). Needs SMTP + APP_PUBLIC_BASE_URL; share WORKER_INTERNAL_SECRET with apps/worker (≥16 chars).
# EMAIL_RENT_PAYMENT_REMINDERS="true"
# WORKER_INTERNAL_SECRET=""
# RENT_REMINDER_BATCH_LIMIT=25
# RENT_REMINDER_MIN_RESERVATION_AGE_HOURS=12    # booking must be at least this old
# RENT_REMINDER_MIN_LEAD_HOURS_BEFORE_PICKUP=24 # pickup at least this many hours away
#
# G3: after upload, queue customer KYC docs for OCR (`POST /v1/internal/cron/customer-document-ocr` with WORKER_INTERNAL_SECRET).
# Long-running vendors: your adapter can call `POST /v1/internal/cron/customer-document-ocr-callback` (same Bearer) with `{ documentId, suggestion }` or `{ documentId, error }` while the row is still PENDING.
# CUSTOMER_DOCUMENT_OCR_AUTO=mock
# — or HTTP adapter (vendor must return JSON matching desk OCR suggestion shape, or `{ "suggestion": { ... } }`):
# CUSTOMER_DOCUMENT_OCR_AUTO=http
# CUSTOMER_DOCUMENT_OCR_HTTP_URL="https://ocr-adapter.example.com/extract"
# CUSTOMER_DOCUMENT_OCR_HTTP_SECRET=""            # optional Bearer token for the adapter
# CUSTOMER_DOCUMENT_OCR_HTTP_TIMEOUT_MS=30000     # 5000–120000
# CUSTOMER_DOCUMENT_OCR_HTTP_VENDOR="MY_VENDOR"   # optional; stored on document (default HTTP)
# CUSTOMER_DOCUMENT_OCR_CRON_BATCH=20
# — G3 (depth): real vendors often need the file bytes — with STORAGE_MODE=s3, POST JSON may include `documentDownloadUrl` (short-lived presigned GET):
# CUSTOMER_DOCUMENT_OCR_HTTP_INCLUDE_PRESIGNED_GET=1
# CUSTOMER_DOCUMENT_OCR_HTTP_PRESIGN_GET_SECONDS=300   # 60–3600; default 300 in code
# — optional request integrity for your OCR middleware (HMAC-SHA256 of `timestamp + "." + body`):
# CUSTOMER_DOCUMENT_OCR_HTTP_HMAC_SECRET=""
#
# G2 (depth): mutual TLS is usually terminated at the edge. When require=1, API expects header from nginx/ALB (e.g. ssl_client_verify → X-Client-Cert-Verified: SUCCESS).
# PARTNER_MTLS_REQUIRE=1
# PARTNER_MTLS_VERIFIED_HEADER_NAME=X-Client-Cert-Verified
# PARTNER_MTLS_VERIFIED_HEADER_VALUE=SUCCESS
#
# G2: OAuth2 client_credentials — separate signing secret strongly recommended in production (≥32 random chars).
# PARTNER_OAUTH_JWT_SECRET=""           # falls back to JWT_SECRET when unset (dev only)
# PARTNER_OAUTH_ACCESS_TOKEN_TTL_SEC=3600   # 300–86400
#
# G2 (depth): optional IPv4 allowlist for `/v1/partner/*` (comma-separated IPs or CIDRs). Requires accurate `req.ip` (set TRUST_PROXY behind nginx/ALB). Misconfigured list → 403.
# Per-key list: desk Organization → partner key → Webhook panel (saved via `PATCH …/partner-api-keys/:id/allowed-ip-cidrs`). When both this env and per-key lists are set, the client must match BOTH (AND).
# PARTNER_API_ALLOWED_IP_CIDRS="203.0.113.10,198.51.100.0/24"
#
# G2: partner reservation.created webhooks — enqueue on create; deliver via internal cron (WORKER_INTERNAL_SECRET) or worker interval.
# PARTNER_WEBHOOK_CRON_BATCH=20
# PARTNER_WEBHOOK_MAX_ATTEMPTS=8
# PARTNER_WEBHOOK_STALE_MS=900000
#
# C3: signed “magic” links for /booking/view?magic=… (lost bookmark). Needs SMTP + APP_PUBLIC_BASE_URL to email.
# PUBLIC_BOOKING_MAGIC_SECRET=""   # random ≥16 chars; different from JWT_SECRET
# PUBLIC_BOOKING_MAGIC_TTL_MINUTES=4320   # default 72h (15 min … 14 days)

# Prisma seed (see prisma/seed.ts) — company, stations, vehicle classes, demo vehicles, admin + agent users
# SEED_COMPANY_ID="00000000-0000-4000-8000-000000000001"   # stable id for NEXT_PUBLIC_DEFAULT_COMPANY_ID (default when creating new Demo Rent)
# SEED_ADMIN_EMAIL="admin@demo.local"
# SEED_ADMIN_PASSWORD="Change-me!23456"
# SEED_AGENT_EMAIL="agent@demo.local"
