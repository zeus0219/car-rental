# Staging web (local or preview). Build-time public vars point the browser at the staging API.
# Copy to .env.staging.local or pass as build args in Docker.
#
# NEXT_PUBLIC_API_URL should match the URL users use to call the **API** (https, /v1).

NEXT_PUBLIC_API_URL=https://api-staging.example.com/v1
# NEXT_PUBLIC_DEFAULT_COMPANY_ID=
# NEXT_PUBLIC_VAT_RATE=0.22
